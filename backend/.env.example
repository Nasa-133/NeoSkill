# Local development only. Production must use APP_ENV=production and a new secret.
APP_ENV=local
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=dev-only-neoskill-change-before-deploy-1234567890-abcdef
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Every browser address the app is opened from. Also the CSRF trusted origin list,
# so add your LAN address or real domain here before signing in from it.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# HTTPS is terminated by your deployment proxy. Enable redirects only after setup.
DJANGO_SSL_REDIRECT=false
# Use localhost for host development. Compose overrides the host with `database`.
POSTGRES_DB=neoskill
POSTGRES_USER=neoskill
POSTGRES_PASSWORD=dev-only-neoskill-postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Uploaded course covers and instructor photos. Mount this as a durable volume.
MEDIA_ROOT=/var/lib/neoskill/media
# Where password reset links point. Must match the public web app origin.
FRONTEND_URL=http://localhost:3000
# Configure all five together to send real mail. Leave empty and reset mail
# is printed to the backend container log instead.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true
