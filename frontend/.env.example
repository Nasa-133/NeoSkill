# The frontend starts and builds without the backend or a database.
PORT=3000
# Where this server forwards /api/v1 requests. Compose sets http://backend:8000.
BACKEND_INTERNAL_URL=http://localhost:8000
# Leave empty to use the same-origin proxy above. Set an absolute URL only when
# the API is served from its own domain.
NEXT_PUBLIC_API_URL=
# Use mock only for development/UI review. Docker production defaults to `api`.
NEXT_PUBLIC_DATA_SOURCE=mock
# Canonical/Open Graph/sitemap origin. Set the real HTTPS origin for a production build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
