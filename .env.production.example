# Copy to .env.production and replace every blank/placeholder before deployment.
PUBLIC_SITE_URL=https://learn.example.com
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=learn.example.com
CORS_ALLOWED_ORIGINS=https://learn.example.com
DJANGO_SSL_REDIRECT=false

POSTGRES_DB=neoskill
POSTGRES_USER=neoskill
POSTGRES_PASSWORD=

# Password-reset links use this origin. Usually it equals PUBLIC_SITE_URL.
FRONTEND_URL=https://learn.example.com
